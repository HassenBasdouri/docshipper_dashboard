// digest_actions.dg — one Custom Function per widget button (see ../app/js/config.js
// ACTION_FUNCTIONS and ../app/js/actions.js). Each function does exactly one CRM write and
// returns immediately — no LLM call here; the note text was already written by
// digest_generate.dg the night before and arrives as a function argument.
//
// Shared safety rules baked into every function below (from the v24.1 spec, Important#2 / B6 /
// A8 / A7 / B7, now generalized from "Alexis" to "the acting user"):
//  - Never write to a Task/Call whose Owner.id isn't the acting user's id — re-checked here even
//    though the widget already filtered client-side, since the CRM can have moved since the
//    digest was generated (Important#3).
//  - A8 channel check (Costing thread present vs. absent) runs fresh on every note post, never
//    cached from the nightly job.
//  - A7 compensation email fires after every tagging note, except when the only tags are CS
//    simples (config.js TEAM.cs).
//  - B7: any date this function receives should already be a weekday; these functions don't
//    silently correct a bad date, they just apply it — validation happens widget-side.
//
// SECURITY — who is "the acting user"? The widget cannot be trusted to say who's acting: if
// every function just took a client-supplied user id as a parameter, any CRM user could pass
// any id and write records as someone else. Every function below instead resolves the real
// actor from Deluge's own session variable (`zoho.loginuserid`), with exactly one named
// exception: HASSEN_ID may pass `viewAsUserId` to explicitly test as another profile (see
// ../app/js/viewAs.js) — and that override only takes effect when `zoho.loginuserid` really is
// Hassen, never based on anything the client claims. See resolveActor() below.
//
// TODO before first real run: confirm every module/field name against the live org; confirm
// `zoho.loginuserid` is in fact populated inside a function invoked via
// ZOHO.CRM.FUNCTIONS.execute from a widget (standard Deluge session variable, but its exact
// propagation through a widget-triggered custom function should be confirmed once deployed).

HASSEN_ID = "4664241000160830001"; // test/admin viewer — see app/js/viewAs.js

// --- digest_dispatch_initial(dealId, aeId, note, followup, viewAsUserId) ---
void digest_dispatch_initial(String dealId, String aeId, String note, Map followup, String viewAsUserId)
{
	actingUserId = resolveActor(viewAsUserId);
	if (getUserProfile(actingUserId) != "Sales Manager") {
		result = Map();
		result.put("ok", false);
		result.put("error", "Action réservée au profil Sales Manager.");
		return result.toJSON();
	}

	// B2 — single-button Initial dispatch: owner change + channel-aware note + A7 email.
	dealUpdate = Map();
	dealUpdate.put("id", dealId);
	ownerMap = Map();
	ownerMap.put("id", aeId);
	dealUpdate.put("Owner", ownerMap);
	updateResp = zoho.crm.updateRecord("Deals", dealId, dealUpdate, {"trigger": {"workflow"}});

	postResult = postNoteWithChannelCheck(dealId, note, actingUserId);

	if (followup != null && followup.get("type") != null) {
		createFollowup(dealId, actingUserId, followup.get("type"), followup.get("date"));
	}

	result = Map();
	result.put("ok", true);
	result.put("owner_update", updateResp);
	result.put("note", postResult);
	return result.toJSON();
}

// --- digest_post_followup_note(dealId, note, targetTag, viewAsUserId) ---
void digest_post_followup_note(String dealId, String note, String targetTag, String viewAsUserId)
{
	actingUserId = resolveActor(viewAsUserId);
	postResult = postNoteWithChannelCheck(dealId, note, actingUserId);
	result = Map();
	result.put("ok", true);
	result.put("note", postResult);
	return result.toJSON();
}

// --- digest_reschedule_item(recordId, module, newDate, viewAsUserId) ---
void digest_reschedule_item(String recordId, String module, String newDate, String viewAsUserId)
{
	actingUserId = resolveActor(viewAsUserId);
	ownerId = getRecordOwnerId(module, recordId);
	if (ownerId != actingUserId) {
		// B6 — never touch another owner's item, even if the widget somehow sent one.
		result = Map();
		result.put("ok", false);
		result.put("error", "Record not owned by the acting user — refusing to reschedule.");
		return result.toJSON();
	}

	update = Map();
	update.put("id", recordId);
	if (module == "Calls") {
		update.put("Call_Start_Time", newDate + "T00:00:00+07:00");
		update.put("Outgoing_Call_Status", "Scheduled"); // F. — without this it stays "Overdue"
	} else {
		update.put("Due_Date", newDate);
	}
	resp = zoho.crm.updateRecord(module, recordId, update);
	result = Map();
	result.put("ok", true);
	result.put("update", resp);
	return result.toJSON();
}

// --- digest_delete_followup(recordId, module, reason, viewAsUserId) ---
void digest_delete_followup(String recordId, String module, String reason, String viewAsUserId)
{
	// B9 — deletion always carries an explicit reason (logged here; the widget already showed
	// a reschedule alternative before calling this).
	actingUserId = resolveActor(viewAsUserId);
	ownerId = getRecordOwnerId(module, recordId);
	if (ownerId != actingUserId) {
		result = Map();
		result.put("ok", false);
		result.put("error", "Record not owned by the acting user — refusing to delete.");
		return result.toJSON();
	}
	info "Deleting " + module + " " + recordId + " — reason: " + reason;
	resp = zoho.crm.deleteRecord(module, recordId);
	result = Map();
	result.put("ok", true);
	result.put("delete", resp);
	return result.toJSON();
}

// --- digest_apply_supervision_batch(decisions, viewAsUserId) ---
// decisions: List of {recordId, module, dealId, decision: "reschedule"|"delete"}
void digest_apply_supervision_batch(List decisions, String viewAsUserId)
{
	actingUserId = resolveActor(viewAsUserId);
	if (getUserProfile(actingUserId) != "Sales Manager") {
		result = Map();
		result.put("ok", false);
		result.put("error", "Action réservée au profil Sales Manager.");
		return result.toJSON();
	}

	results = List();
	for each d in decisions {
		recordId = d.get("recordId");
		module = d.get("module");
		ownerId = getRecordOwnerId(module, recordId);
		if (ownerId != actingUserId) { continue; } // D4 — the consigne only ever touches the acting user's items
		if (d.get("decision") == "delete") {
			results.add(zoho.crm.deleteRecord(module, recordId));
		} else if (d.get("decision") == "reschedule") {
			// resume date already computed in step 1 (D4 — lendemain ouvré de l'échéance du référent)
			results.add(digest_reschedule_item(recordId, module, d.get("resumeDate"), viewAsUserId));
		}
	}
	result = Map();
	result.put("ok", true);
	result.put("applied", results.size());
	return result.toJSON();
}

// --- digest_redispatch_b2b_lost(dealId, aeId, note, viewAsUserId) ---
void digest_redispatch_b2b_lost(String dealId, String aeId, String note, String viewAsUserId)
{
	actingUserId = resolveActor(viewAsUserId);
	if (getUserProfile(actingUserId) != "Sales Manager") {
		result = Map();
		result.put("ok", false);
		result.put("error", "Action réservée au profil Sales Manager.");
		return result.toJSON();
	}

	// D5 — deal owner NEVER changes on a B2B Lost redispatch, no follow-up is created for the
	// acting user. This function deliberately has no owner-update step, unlike dispatch_initial.
	postResult = postNoteWithChannelCheck(dealId, note, actingUserId);
	result = Map();
	result.put("ok", true);
	result.put("note", postResult);
	return result.toJSON();
}

// --- digest_cancel_ghost_call(recordId, viewAsUserId) ---
void digest_cancel_ghost_call(String recordId, String viewAsUserId)
{
	actingUserId = resolveActor(viewAsUserId);
	ownerId = getRecordOwnerId("Calls", recordId);
	if (ownerId != actingUserId) {
		result = Map();
		result.put("ok", false);
		result.put("error", "Call not owned by the acting user — refusing to cancel.");
		return result.toJSON();
	}
	resp = zoho.crm.deleteRecord("Calls", recordId);
	result = Map();
	result.put("ok", true);
	result.put("delete", resp);
	return result.toJSON();
}

// ============================= shared helpers =============================

// The real actor is always the invoking CRM session — never a client-supplied id — except that
// Hassen (HASSEN_ID) may pass a `viewAsUserId` to explicitly test another profile's actions.
// This is the ONLY place impersonation is allowed anywhere in this file.
String resolveActor(String viewAsUserId)
{
	realUserId = zoho.loginuserid; // Deluge's own session variable — not client-controlled
	if (realUserId == HASSEN_ID && viewAsUserId != null && viewAsUserId != "") {
		return viewAsUserId;
	}
	return realUserId;
}

// A8 — channel decision, re-checked fresh on every call (never trust the nightly job's read).
Map postNoteWithChannelCheck(String dealId, String note, String actingUserId)
{
	costingThread = zoho.crm.searchRecords("Chats", "(Deals_Chat:equals:" + dealId + ")and(Name:equals:Costing)");

	if (costingThread != null && costingThread.size() > 0) {
		msg = Map();
		msg.put("Name", "Parent Message-" + costingThread.get(0).get("id") + "-" + dealId);
		chatRef = Map();
		chatRef.put("id", costingThread.get(0).get("id"));
		msg.put("Chats", chatRef);
		msg.put("Message_Text", note.replaceAll("\n", "<br>"));
		msg.put("AuthorID", actingUserId);
		createResp = zoho.crm.createRecord("MessagesChat", msg);
	} else {
		note2 = Map();
		note2.put("Note_Title", "DISPATCH — note pour l'AE");
		note2.put("Note_Content", note);
		parentId = Map();
		parentModule = Map();
		parentModule.put("api_name", "Deals");
		parentId.put("id", dealId);
		parentId.put("module", parentModule);
		note2.put("Parent_Id", parentId);
		createResp = zoho.crm.createNotesModule(note2); // TODO: confirm exact Deluge task name/signature for this on the current runtime
	}

	sendCompensationEmails(dealId, note, actingUserId);

	result = Map();
	result.put("posted", true);
	return result;
}

// A4/A7 — one compensation email per non-CS tagged person (Important#5 exception for CS simples
// lives in ../app/js/config.js requiresCompensationEmail; mirrored here server-side since this
// is the actual send path).
void sendCompensationEmails(String dealId, String note, String actingUserId)
{
	tags = extractTags(note); // TODO: implement — regex "@([A-ZÀ-Ý][\\w' -]+)" against `note`,
		// matched against the directory to resolve to an email + full name.
	deal = zoho.crm.getRecord("Deals", dealId);
	dealName = deal.get("Deal_Name");
	dealUrl = "https://" + zoho.crm.getOrgVariable("Crm_domain") + "/crm/tab/Deals/" + dealId;
	actor = getUserInfo(actingUserId);

	for each person in tags {
		if (person.get("is_cs_simple") == true) { continue; } // Important#5 exception
		htmlBody = buildCompensationEmailHtml(actor.get("name"), person.get("first_name"), dealName, note, dealUrl);
		sendmail
		[
			from: actor.get("email") // TODO: replace with the Gmail Connection send path (ANALYSIS.md §6) — Deluge's native sendmail won't originate from a real external Gmail address the way A7 requires
			to: person.get("email")
			subject: "You were mentioned in a chat - " + dealName
			message: htmlBody
			content type: "html"
		];
	}
}

String buildCompensationEmailHtml(String actorName, String firstName, String dealName, String note, String dealUrl)
{
	noteHtml = note.replaceAll("\n", "<br>");
	return "<div style=\"font-family: Arial, sans-serif; line-height: 1.6; margin: 20px; background-color: #f4f4f9; padding: 20px;\">"
		+ "<div style=\"max-width: 600px; margin: 0 auto; padding: 20px; background: #ffffff; border-radius: 8px; box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);\">"
		+ "<h1 style=\"color: #333333; text-align: center; margin-top: 0;\">Mention Notification</h1>"
		+ "<p style=\"color: #555555;\"><strong>" + actorName + "</strong> mentioned you in a chat.</p>"
		+ "<p style=\"color: #555555;\">Hello " + firstName + ",</p>"
		+ "<p style=\"color: #555555;\">Deal: <strong>" + dealName + "</strong></p>"
		+ "<p style=\"color: #555555;\">Message:</p>"
		+ "<div style=\"background: #f1f1f1; padding: 10px; border-radius: 5px; margin-top: 10px; color: #333333;\">" + noteHtml + "</div>"
		+ "<div style=\"text-align: center; margin-top: 20px;\"><p style=\"color: #555555;\">Click below to view deal details:</p>"
		+ "<p><a href=\"" + dealUrl + "\">Open Deal</a></p></div>"
		+ "<p style=\"color: #555555;\">Thank you,</p><p style=\"color: #555555;\">Tech Team</p></div></div>";
}

String getRecordOwnerId(String module, String recordId)
{
	rec = zoho.crm.getRecord(module, recordId);
	return rec.get("Owner").get("id");
}

void createFollowup(String dealId, String ownerId, String type, String date)
{
	dealRef = Map();
	dealRef.put("id", dealId);
	if (type == "call") {
		call = Map();
		call.put("Subject", "Call scheduled");
		call.put("Call_Type", "Outbound");
		call.put("Call_Start_Time", date + "T00:00:00+07:00");
		call.put("Call_Duration", "00:00");
		call.put("Outgoing_Call_Status", "Scheduled");
		call.put("What_Id", dealRef);
		call.put("$se_module", "Deals");
		owner = Map();
		owner.put("id", ownerId);
		call.put("Owner", owner);
		zoho.crm.createRecord("Calls", call);
	} else if (type == "task") {
		task = Map();
		task.put("Subject", "Suivi digest");
		task.put("Due_Date", date);
		task.put("What_Id", dealRef);
		task.put("$se_module", "Deals");
		owner = Map();
		owner.put("id", ownerId);
		task.put("Owner", owner);
		zoho.crm.createRecord("Tasks", task);
	}
}

// Live profile/name/email lookup — used both here (actor resolution, profile guards) and by
// digest_collect.dg / digest_generate.dg (never trust a cached profile from a prior run).
// TODO: confirm exact Deluge task name/signature for a single-user lookup on this runtime —
// verified patterns in this file use getRecord/searchRecords for Tasks/Calls/Deals, not Users.
String getUserProfile(String userId)
{
	user = zoho.crm.getUsers(userId); // TODO: confirm signature — may need a "type"/"index" arg on this Deluge runtime
	return user.get("profile").get("name");
}

Map getUserInfo(String userId)
{
	user = zoho.crm.getUsers(userId); // TODO: same confirmation as getUserProfile
	info = Map();
	info.put("name", user.get("full_name"));
	info.put("email", user.get("email"));
	return info;
}
