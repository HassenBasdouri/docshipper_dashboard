// digest_collect_004_sales.dg — 004-SALES profile's nightly CRM read.
//
// Same underlying primitives as the Sales Manager collector (own Tasks/Calls, Gold-heat
// classification — see ../shared/) but scoped entirely to the rep's own deals: no
// ownership-contention split (path1/path2/supervision), since a rep has no equivalent of "is
// someone else on it" the way a manager supervising other AEs does. No AE-redispatch/piloted
// split on B2B Lost either — the rep already owns it, there's no "who's piloting this" question.
// (User-confirmed scope — see ../../CLAUDE.md.)
//
// Returns a JSON-stringified Map — Standalone category functions can only declare return type
// string; callers parse the result back with .toMap() immediately at the call site.

string standalone.digest_collect_004_sales(String userId)
{
	today = zoho.currentdate;
	todayStr = today.toString("yyyy-MM-dd");

	result = Map();
	result.put("run_date", todayStr);
	result.put("profile", "004-SALES");

	// personal_tasks — this rep's own open Tasks/Calls, same primitive as the Sales Manager badge.
	own = standalone.collectOwnTasksCalls(userId).toMap();
	result.put("personal_tasks_deal_ids", own.get("deal_ids"));
	result.put("personal_tasks_deal_facts", own.get("deal_facts"));

	// initial_own — this rep's own Initial-stage deals, same Gold-heat classification as the
	// Sales Manager's dispatch queue, but shown read-only widget-side (see app/js/render.js's
	// "initial-info" section type — no dispatch action, the rep already IS the AE). Trimmed via
	// ../shared/trim_deal_fields.dg — searchRecords returns the full record, and this ends up
	// embedded in the Claude prompt (see ../shared/collect_own_tasks_calls.dg's header for why
	// that matters — an untrimmed prompt hit Anthropic's 200,000-token limit live).
	initialDealsRaw = zoho.crm.searchRecords("Deals", "(Owner:equals:" + userId + ")and(Stage:equals:Initial)");
	initialDeals = List();
	for each d in initialDealsRaw { initialDeals.add(standalone.trimDealFields(d).toMap()); }
	result.put("initial_own_rows", standalone.classifyInitialDeals(initialDeals.toString()).toJSONList());

	// b2b_lost_own — this rep's own B2B Lost deals, to work themselves.
	b2bLostRaw = zoho.crm.searchRecords("Deals", "(Owner:equals:" + userId + ")and(Stage:equals:B2B Lost)");
	b2bLost = List();
	for each d in b2bLostRaw { b2bLost.add(standalone.trimDealFields(d).toMap()); }
	result.put("b2b_lost_own_rows", b2bLost);

	return result.toString();
}
