// digest_collect.dg — nightly step 1 router (scheduled ~07:00, runs before digest_generate.dg)
//
// Routes to a profile-specific collector so each profile's CRM-reading rules live in their own
// file instead of one growing conditional. All CRM reading happens in those files, in as few,
// wide COQL calls as possible — this is the credit-cost-sensitive half of the job (see
// ANALYSIS.md §2/§3). Everything that can be decided without judgment (owner ids, Gold routing,
// weekday dates, D1-D8 bucket assignment) is decided in the collector, not left for the LLM
// step. Adding a real profile later means writing one new digest_collect_<profile>.dg + one
// branch here — see digest_collect_stub.dg for the minimal shape a new collector must return.
//
// TODO before first real run: confirm every module/field name against the live org (they're
// taken from the v24.1 policy doc's F. section, verified there on 26/08 — schema may have
// moved since).

Map digest_collect(String userId)
{
	profileName = getUserProfile(userId); // live lookup, never cached — see digest_actions.dg's getUserProfile helper

	if (profileName == "Sales Manager") { return digest_collect_sales_manager(userId); }
	if (profileName == "004-SALES") { return digest_collect_004_sales(userId); }
	return digest_collect_stub(userId, profileName);
}

// ============================= shared helpers =============================
// Reused by every profile's collector (digest_collect_sales_manager.dg, _004_sales.dg,
// _stub.dg) so the primitives underneath — "read my own open activity", "classify Initial
// deals" — exist exactly once.

// Steps 1+2 from the original single-user script: this user's own active Tasks/Calls (ONE wide
// query each, not per-deal), the distinct deal ids they touch, and the Stage + key fields for
// every one of those deals (ONE batched COQL, id in (...), not one call per deal).
Map collectOwnTasksCalls(String userId)
{
	tasks = zoho.crm.searchRecords("Tasks", "(Owner:equals:" + userId + ")and(Status:equals:Not Started)");
	calls = zoho.crm.searchRecords("Calls", "(Owner:equals:" + userId + ")and(Outgoing_Call_Status:in:Scheduled,Overdue)");

	dealIds = List();
	for each t in tasks { if (t.get("What_Id") != null) { dealIds.add(t.get("What_Id").get("id")); } }
	for each c in calls { if (c.get("What_Id") != null) { dealIds.add(c.get("What_Id").get("id")); } }
	dealIds = dealIds.distinct();

	dealFacts = Map();
	if (dealIds.size() > 0) {
		idList = dealIds.toString().replaceAll("\\[|\\]", "");
		dealsQuery = "select id, Deal_Name, Stage, Owner, Country_of_Departure, Country_of_Arrival, "
			+ "Total_Weight_KG, Volume_m3, Value_of_goods, Incoterm_of_departure, Incoterms_of_arrival, "
			+ "Shipping_Instructions_Date, Last_Activity_Time from Deals where id in (" + idList + ") limit 2000";
		dealRows = zoho.crm.getRecords("Deals", 1, 200); // TODO: swap to a COQL invokeurl call using dealsQuery above once the connector path is confirmed
		for each d in dealRows {
			dealFacts.put(d.get("id"), d);
		}
	}

	bundle = Map();
	bundle.put("tasks", tasks);
	bundle.put("calls", calls);
	bundle.put("deal_ids", dealIds);
	bundle.put("deal_facts", dealFacts);
	return bundle;
}

// Step 4 from the original script: Gold-heat detection is pure data, no LLM needed for the flag.
List classifyInitialDeals(List deals)
{
	goldPairs = {"China": true, "Vietnam": true, "Hong Kong": true}; // TODO: replace with the real Asia<->Europe country-pair table
	rows = List();
	for each deal in deals {
		dep = deal.get("Country_of_Departure");
		arr = deal.get("Country_of_Arrival");
		isGold = (goldPairs.containKey(dep) || goldPairs.containKey(arr)); // placeholder — real rule: Asia<->Europe, excluding Middle East
		row = Map();
		row.put("deal_id", deal.get("id"));
		row.put("deal", deal);
		row.put("heat", isGold ? "gold" : "moyen"); // TODO: full C1 speed-tiering (rapide/moyen/prudence/douce)
		rows.add(row);
	}
	return rows;
}
